# Plantilla de configuración de un nodo. Copiar a config/<nodo>.env y ajustar.
# No colocar contraseñas ni tokens reales en archivos versionados.

# Identificador corto y único del nodo (se guarda como origin_node en cada incidente)
NODE_ID=A
# Nombre descriptivo del sector que atiende este nodo
NODE_NAME=Sector Norte
# Interfaz de escucha. 127.0.0.1 = solo esta máquina (recomendado).
# Usar 0.0.0.0 únicamente en una LAN de laboratorio con regla de firewall (ver docs/RED_MESH_MANET.md)
HOST=127.0.0.1
PORT=3001
# Archivo SQLite propio del nodo (distribución física simulada)
DB_PATH=data/nodeA.db
# Peers separados por coma con formato ID=URL
PEERS=B=http://127.0.0.1:3002
# Timeout (ms) para peticiones entre nodos
PEER_TIMEOUT_MS=1500
# Intervalo (ms) del sondeo de salud a los peers
HEARTBEAT_MS=5000
# Intervalo (ms) del proceso que envia la cola persistente (outbox) a los peers
SYNC_INTERVAL_MS=3000
# SYNC_SECRET: secreto compartido opcional entre nodos. NO escribirlo aqui ni versionarlo;
# definirlo en el entorno del proceso (ver docs/SINCRONIZACION.md).
